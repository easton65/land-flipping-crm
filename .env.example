# ---------------------------------------------------------------------------
# Stripe configuration
# Copy this file to `.env` and fill in your TEST-mode keys while developing.
# Get keys at: https://dashboard.stripe.com/test/apikeys
# NEVER commit the real .env file. Rotate any key that leaks.
# ---------------------------------------------------------------------------

# Secret key (server-side only). Test keys start with sk_test_...
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key (safe for frontend). Test keys start with pk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Webhook signing secret for the /webhooks/stripe endpoint.
# When testing locally with the Stripe CLI, `stripe listen` prints this (whsec_...).
# In production, copy it from the webhook endpoint you create in the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public base URL of THIS app — used to build Checkout success/cancel redirect URLs.
APP_BASE_URL=http://localhost:4242

# Port the server listens on.
PORT=4242

# ---------------------------------------------------------------------------
# Optional: pre-created Price IDs for your subscription plans (Billing).
# Create Products/Prices in the Dashboard or via the API, then paste IDs here.
# ---------------------------------------------------------------------------
PRICE_ID_PRO_MONTHLY=price_replace_me
PRICE_ID_PRO_YEARLY=price_replace_me
